{
  "tools": [
    {
      "name": "request_payment",
      "description": "Creates a payment request for an approved invoice. Dry run by default. Needs an approval id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice_number": {
            "type": "string",
            "description": "The invoice number associated with the payment request"
          },
          "vendor_id": {
            "type": "string",
            "description": "Unique identifier for the vendor"
          },
          "amount": {
            "type": "number",
            "description": "Payment amount"
          },
          "currency": {
            "type": "string",
            "description": "Currency code (e.g., USD, EUR)"
          },
          "approval_id": {
            "type": "string",
            "description": "Unique identifier for the payment approval"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Unique key to prevent duplicate payments"
          },
          "dry_run": {
            "type": "boolean",
            "description": "Whether to run as a dry run without processing actual payment",
            "default": true
          }
        },
        "required": [
          "invoice_number",
          "vendor_id",
          "amount",
          "currency",
          "approval_id",
          "idempotency_key"
        ]
      },
      "annotations": {
        "title": "Request Payment",
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ]
}